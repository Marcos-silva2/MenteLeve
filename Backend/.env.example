# Banco de dados.
# Local (padrão): SQLite no diretório do projeto.
DATABASE_URL=sqlite:///./menteleve.db
# No Render, use o disco persistente montado, ex.:
# DATABASE_URL=sqlite:////var/data/menteleve.db
# Supabase (Postgres) — use o "Session pooler" (IPv4), não a "Direct connection"
# (que é IPv6-only): painel → Connect → Connection string → Session pooler.
# Troque o prefixo postgresql:// por postgresql+psycopg:// para usar o driver psycopg:
# DATABASE_URL=postgresql+psycopg://postgres.xxxxxxxx:SENHA@aws-0-REGIAO.pooler.supabase.com:5432/postgres

# CORS — origens permitidas (separadas por vírgula). "*" libera todas (dev).
# Produção, ex.: CORS_ORIGINS=https://seu-usuario.github.io
CORS_ORIGINS=*

# --- Autenticação (JWT) ---
# Chave de assinatura dos tokens. OBRIGATÓRIA em produção: sem ela o backend
# gera uma chave aleatória a cada boot e todas as sessões caem a cada restart
# (no Render free, a cada cold start). Gere uma com:
#   python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=
# Validade do token em minutos (opcional). Padrão: 43200 (30 dias)
# ACCESS_TOKEN_EXPIRE_MINUTES=43200

# --- Limite de tentativas de login (opcional) ---
# Janela deslizante em memória, contando apenas as FALHAS. Um acerto zera a
# contagem, então quem sabe a senha não é punido por ter errado antes.
# Padrões: 8 falhas por e-mail e 30 por IP, ambos em 900 s (15 min).
# LOGIN_MAX_ATTEMPTS=8
# LOGIN_MAX_ATTEMPTS_PER_IP=30
# LOGIN_ATTEMPT_WINDOW_SECONDS=900

# --- Assinatura Premium ---
# "true" (padrão) mantém a compra SIMULADA do MVP: a usuária ativa o Premium
# pelo próprio app, via POST /auth/me/premium/simulate, sem cobrança.
# Com "false" essa rota passa a responder 403 e a concessão só pode vir de uma
# confirmação de pagamento no servidor.
#
# ⚠️ PRECISA virar "false" no dia em que houver cobrança de verdade.
# SIMULATED_CHECKOUT=true

# --- Criptografia do conteúdo em repouso (AES-256-GCM) ---
# Criptografa o título das tarefas e o nome da usuária ANTES de gravar, para que
# um dump do banco (ou o painel do Supabase) não revele o conteúdo. Sem ela o app
# funciona, mas grava em texto puro e avisa no boot.
# Gere com:
#   python -c "import secrets; print(secrets.token_hex(32))"
#
# ⚠️ PERDER ESTA CHAVE TORNA OS DADOS JÁ GRAVADOS IRRECUPERÁVEIS. Não existe
# recuperação — guarde uma cópia num gerenciador de senhas, fora do servidor.
# Use o MESMO valor no local e no Render, senão cada ambiente lê só o que gravou.
ENCRYPTION_KEY=

# --- IA (Google AI Studio / Gemini) ---
# Chave da API do Google AI Studio (https://aistudio.google.com/apikey).
# Sem ela, o /tasks/smart funciona em modo fallback (sem sugestões).
GOOGLE_AI_API_KEY=
# Modelo Gemini (opcional). Padrão: gemini-2.5-flash
# AI_MODEL=gemini-2.5-flash
# Timeout da chamada à IA em segundos (opcional). Padrão: 8
# AI_TIMEOUT=12
# Timeout do chat da Bruna (opcional). Padrão: 25 — ela pode fazer duas idas ao
# modelo (function calling), e a API tem picos de latência.
# AI_CHAT_TIMEOUT=25

# --- IA de reserva (Groq) ---
# Usada automaticamente quando o Gemini falha ou estoura a cota (429). O plano
# gratuito do Gemini permite ~20 req/min. Chave grátis, sem cartão:
# https://console.groq.com
GROQ_API_KEY=
# Modelo do Groq (opcional). Os disponíveis variam por conta — consulte
# https://api.groq.com/openai/v1/models com a sua chave.
# GROQ_MODEL=openai/gpt-oss-120b
