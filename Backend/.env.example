# Banco de dados.
# Local (padrão): SQLite no diretório do projeto.
DATABASE_URL=sqlite:///./menteleve.db
# No Render, use o disco persistente montado, ex.:
# DATABASE_URL=sqlite:////var/data/menteleve.db
# Supabase (Postgres) — use o "Session pooler" (IPv4), não a "Direct connection"
# (que é IPv6-only): painel → Connect → Connection string → Session pooler.
# Troque o prefixo postgresql:// por postgresql+psycopg:// para usar o driver psycopg:
# DATABASE_URL=postgresql+psycopg://postgres.xxxxxxxx:SENHA@aws-0-REGIAO.pooler.supabase.com:5432/postgres

# CORS — origens permitidas (separadas por vírgula). "*" libera todas (dev).
# Produção, ex.: CORS_ORIGINS=https://seu-usuario.github.io
CORS_ORIGINS=*

# --- Autenticação (JWT) ---
# Chave de assinatura dos tokens. OBRIGATÓRIA em produção: sem ela o backend
# gera uma chave aleatória a cada boot e todas as sessões caem a cada restart
# (no Render free, a cada cold start). Gere uma com:
#   python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=
# Validade do token em minutos (opcional). Padrão: 43200 (30 dias)
# ACCESS_TOKEN_EXPIRE_MINUTES=43200

# --- IA (Google AI Studio / Gemini) ---
# Chave da API do Google AI Studio (https://aistudio.google.com/apikey).
# Sem ela, o /tasks/smart funciona em modo fallback (sem sugestões).
GOOGLE_AI_API_KEY=
# Modelo Gemini (opcional). Padrão: gemini-2.5-flash
# AI_MODEL=gemini-2.5-flash
# Timeout da chamada à IA em segundos (opcional). Padrão: 8
# AI_TIMEOUT=12
# Timeout do chat da Bruna (opcional). Padrão: 25 — ela pode fazer duas idas ao
# modelo (function calling), e a API tem picos de latência.
# AI_CHAT_TIMEOUT=25
